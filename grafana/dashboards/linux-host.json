  "panels": [
    {
      "datasource": "Prometheus",
      "fieldConfig": {"defaults": {},"overrides": []},
      "gridPos": {"h": 8,"w": 12,"x": 0,"y": 0},
      "id": 1,
      "title": "CPU Usage (%)",
      "type": "gauge",
      "options": {"orientation": "auto","min": 0,"max": 100},
      "targets": [
        {
          "expr": "100 * (1 - avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))",
          "format": "time_series",
          "interval": "",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {"defaults": {},"overrides": []},
      "gridPos": {"h": 8,"w": 12,"x": 12,"y": 0},
      "id": 2,
      "title": "Memory Usage (%)",
      "type": "gauge",
      "options": {"orientation": "auto","min": 0,"max": 100},
      "targets": [
        {
          "expr": "100 * (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes))",
          "format": "time_series",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {"defaults": {},"overrides": []},
      "gridPos": {"h": 8,"w": 12,"x": 0,"y": 8},
      "id": 3,
      "title": "Disk Usage (%) (non-tmpfs)",
      "type": "gauge",
      "options": {"orientation": "auto","min": 0,"max": 100},
      "targets": [
        {
          "expr": "100 * (1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay\"})",
          "format": "time_series",
          "legendFormat": "{{instance}} {{mountpoint}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {"defaults": {},"overrides": []},
      "gridPos": {"h": 8,"w": 12,"x": 12,"y": 8},
      "id": 4,
      "title": "Process Count (running)",
      "type": "stat",
      "options": {"orientation": "auto"},
      "targets": [
        {
          "expr": "node_procs_running",
          "format": "time_series",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    }
  ],
